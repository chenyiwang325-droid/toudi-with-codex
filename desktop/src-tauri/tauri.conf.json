{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TouDi",
  "version": "0.6.12",
  "identifier": "io.github.chenyiwang325-droid.toudi",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TouDi · 投递中控台",
        "width": 1360,
        "height": 880,
        "minWidth": 860,
        "minHeight": 600,
        "backgroundColor": "#f4f6f7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; script-src-attr 'unsafe-inline'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: ipc: http://ipc.localhost; frame-src 'self' blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "与 Codex 协作的个人投递工作台",
    "longDescription": "Codex 维护同一份本机求职资料，TouDi 管理投递、准备、探查、复盘与日程，Chrome 扩展通过 Luna 核对填报；保留完整手动操作。",
    "resources": [
      "runtime/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
