{
  "manifest_version": 3,
  "name": "TouDi 辅助填报",
  "version": "0.5.22",
  "description": "当前招聘网页的资料识别、核对与填写；推荐通过 Codex 调用 Luna。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "TouDi 辅助填报"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": "",
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "profile-view.js",
        "popup.css",
        "interface.css",
        "interface-motion.js",
        "popup.js",
        "agent-config.js",
        "logo.svg",
        "filling-workflow.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
