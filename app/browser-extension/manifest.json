{
  "manifest_version": 3,
  "name": "TouDi 辅助填报",
  "version": "0.4.3",
  "description": "当前招聘网页的个人资料识别、核对与填写；可自行配置 Agent 协作。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "TouDi 辅助填报",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": ""
}
