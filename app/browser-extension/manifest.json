{
  "manifest_version": 3,
  "name": "TouDi 辅助填报",
  "version": "0.2.0",
  "description": "使用插件本地资料检查并填写当前网申页面，可通过现有 Codex 额度调用 Luna 核对歧义。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "action": {
    "default_title": "TouDi 辅助填报",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": ""
}
